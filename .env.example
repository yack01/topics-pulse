# Copy to .env and adjust as needed:  cp .env.example .env

# --- Postgres ---
POSTGRES_USER=topicspulse
POSTGRES_PASSWORD=topicspulse
POSTGRES_DB=topicspulse
POSTGRES_PORT=5432

# --- Ollama (embeddings + LLM runtime) ---
OLLAMA_PORT=11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_LLM_MODEL=qwen2.5:3b
# How long Ollama keeps a model loaded in RAM after last use, before
# unloading it. Lower = less RAM held idle, but more reload latency on the
# next call. Important for the ~4GB RAM budget this stack targets.
OLLAMA_KEEP_ALIVE=5m
OLLAMA_REQUEST_TIMEOUT=120s

# --- Background embedding worker (runs inside the api process) ---
EMBEDDING_POLL_INTERVAL=5s
EMBEDDING_BATCH_SIZE=20

# --- Nightly topic analysis (also inside the api process) ---
# Standard 5-field cron expression, evaluated in the container's local time (UTC by default).
ANALYSIS_CRON=0 3 * * *
# Fixed periods GET /topics can be queried for; precomputed every night.
ANALYSIS_PERIODS=24h,7d,30d
# How many messages (random sample) are shown to the LLM per period to discover candidate topics.
ANALYSIS_SAMPLE_SIZE=1200
# Sample is split into LLM calls of this many messages each.
ANALYSIS_BATCH_SIZE=200
# Max topics kept after merge, and max returned by GET /topics.
ANALYSIS_MAX_TOPICS=20
# Minimum cosine similarity for a message to be assigned to a topic centroid; below this it's treated as unrelated noise.
ANALYSIS_MIN_SIMILARITY=0.45

# --- Per-user on-demand analysis (GET /users/{login}/topics) ---
USER_TOPICS_MAX_MESSAGES=500
USER_TOPICS_MAX_TOPICS=10

# --- Full-text search (GET /messages/search) ---
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100

# --- API ---
API_PORT=8080
